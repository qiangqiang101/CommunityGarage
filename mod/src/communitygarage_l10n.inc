     "msgstr \"Community Garage no GitHub\"\n"
     "\n"
     "msgctxt \"row.Website.description\"\n"
     "msgid \"Releases, what's new, and the player guide.\"\n"
     "msgstr \"Vers\303\265es, novidades e o guia do jogador.\"\n"
